{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "start": "wrangler dev src/index.ts",
    "build": "tsc",
    "deploy": "wrangler deploy src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:to-sql": "prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script --output ./prisma/migrations/init.sql",
    "prisma:migrate": "wrangler d1 migrations apply mars-db --local",
    "prisma:migrate:remote": "wrangler d1 migrations apply mars-db --remote",
    "prisma:studio": "prisma studio",
    "seed": "wrangler d1 execute mars-db --local --file=./prisma/seed.sql",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "wrangler": "^4.6.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.14",
    "bcryptjs": "^2.4.3",
    "hono": "^4.7.5",
    "hono-sessions": "^0.7.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "zod": "^3.24.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "tsc --noEmit"
  }
}
