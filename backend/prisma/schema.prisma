generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  username  String     @unique
  email     String     @unique
  password  String
  userRoles UserRole[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  
  @@unique([userId, role])
}

model PiniaState {
  storeId   String   @id @unique
  state     String
  updatedAt DateTime @default(now()) @updatedAt
} 

model File {
  id           String   @id @default(uuid())
  key          String   @unique
  url          String
  size         Int
  contentType  String
  createdAt    DateTime @default(now())
}

model Journal {
  id            String          @id @default(uuid())
  disciplineId  String
  groupName     String?
  academicYear  String
  semester      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  students      JournalStudent[]
  marks         Mark[]
  
  @@index([disciplineId])
  @@index([academicYear, semester])
}

model JournalStudent {
  id          String    @id @default(uuid())
  journalId   String
  studentId   String
  journal     Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  
  @@unique([journalId, studentId])
  @@index([studentId])
}

model Mark {
  id              String    @id @default(uuid())
  journalId       String
  studentId       String
  columnIndex     Int
  rowIndex        Int
  value           String?
  columnType      String    // "date" | "session"
  columnDate      String?   // ISO date for date columns
  columnLabel     String?   // Label for session columns
  controlType     String?   // "intermediate" | "final"
  controlId       String?
  sessionId       String?
  scheduledControlId String?
  
  journal         Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@unique([journalId, studentId, columnIndex, rowIndex])
  @@index([journalId, studentId])
  @@index([studentId])
}

model MarkHistory {
  id              String    @id @default(uuid())
  journalId       String
  studentId       String
  columnIndex     Int
  rowIndex        Int
  oldValue        String?
  newValue        String?
  columnLabel     String?
  columnDate      String?
  
  createdAt       DateTime  @default(now())
  createdBy       String?
  
  @@index([journalId, studentId])
  @@index([createdAt])
} 
