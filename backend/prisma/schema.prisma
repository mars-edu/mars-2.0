generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  username  String     @unique
  email     String     @unique
  password  String
  userRoles UserRole[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  
  @@unique([userId, role])
} 