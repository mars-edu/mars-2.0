{
  "name": "mars",
  "private": true,
  "version": "1.0.0",
  "description": "Mars",
  "repository": "",
  "license": "PROPRIETARY",
  "scripts": {
    "start": "npm run dev:all",
    "dev": "cross-env NODE_ENV=development vite",
    "dev:convex": "npx convex dev",
    "dev:all": "npm run dev:convex & npm run dev",
    "build": "cross-env NODE_ENV=production vite build",
    "build:convex": "npx convex codegen && npx convex deploy --cmd 'npm run build' && ./scripts/run-migrations.sh",
    "migrate": "./scripts/run-migrations.sh",
    "postinstall": "./scripts/postinstall.sh",
    "patch:framework7": "./scripts/generate-framework7-popover-patch.sh",
    "preview": "npm run build && cross-env NODE_ENV=production vite preview",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.config.dev.ts",
    "test:e2e:prod": "playwright test --config=playwright.config.prod.ts",
    "test:e2e:all": "npm run test:e2e:dev && npm run test:e2e:prod",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:headed:slow": "HEADED=1 playwright test",
    "test:e2e:headed:slower": "HEADED=1 SLOWMO=2000 playwright test",
    "test:e2e:headed:slowest": "HEADED=1 SLOWMO=3000 playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:component": "playwright test -c playwright-ct.config.ts",
    "test:all": "npm run test:e2e && npm run test:component",
    "test:report": "playwright show-report",
    "test:install": "playwright install --with-deps"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 25 Chrome versions",
    "last 25 Firefox versions"
  ],
  "overrides": {
    "vite": "^8.0.0-beta.7"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/vue": "^3.0.116",
    "@types/sortablejs": "^1.15.9",
    "@vueuse/core": "^14.1.0",
    "ai": "^6.0.116",
    "baseline-browser-mapping": "^2.9.14",
    "bcryptjs": "^3.0.3",
    "caniuse-lite": "^1.0.30001764",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.3",
    "convex-vue": "^0.1.5",
    "cyrillic-to-translit-js": "^3.2.1",
    "dayjs": "^1.11.19",
    "dom7": "^4.0.6",
    "es-toolkit": "^1.43.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framework7": "^9.0.2",
    "framework7-icons": "^5.0.5",
    "framework7-vue": "^9.0.2",
    "fuse.js": "^7.1.0",
    "jose": "^6.1.3",
    "jszip": "^3.10.1",
    "livekit-client": "^2.17.2",
    "localforage": "^1.10.0",
    "lucide-vue-next": "^0.561.0",
    "mammoth": "^1.11.0",
    "maska": "^3.2.0",
    "material-icons": "^1.13.14",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sharp": "^0.34.5",
    "skeleton-elements": "^4.0.1",
    "sortablejs": "^1.15.6",
    "svgo": "^4.0.0",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vue": "^3.5.26",
    "vue-advanced-cropper": "^2.8.9",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@iconify/vue": "^5.0.0",
    "@playwright/experimental-ct-vue": "^1.57.0",
    "@playwright/test": "^1.57.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.5.26",
    "autoprefixer": "^10.4.23",
    "cpy-cli": "^6.0.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.6.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass-embedded": "^1.97.2",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "vite": "^8.0.0-beta.7",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-webfont-dl": "^3.11.1"
  }
}
