{
  "name": "mars",
  "private": true,
  "version": "1.0.0",
  "description": "Mars",
  "repository": "",
  "license": "PROPRIETARY",
  "scripts": {
    "start": "npm run dev:all",
    "dev": "cross-env NODE_ENV=development vite",
    "dev:convex": "npx convex dev",
    "dev:all": "npm run dev:convex & npm run dev",
    "build:paraglide": "npm run build:paraglide:frontend && npm run build:paraglide:backend",
    "build:paraglide:frontend": "paraglide-js compile --project project.frontend.inlang",
    "build:paraglide:backend": "paraglide-js compile --project project.backend.inlang --outdir ./convex/paraglide --silent && rm -f ./convex/paraglide/server.js",
    "build": "cross-env NODE_ENV=production NO_COLOR=1 vite build",
    "build:convex": "npm run build:paraglide:backend && npx convex codegen && npx convex deploy --check-build-environment disable --cmd 'npm run build'",
    "migrate:status": "npx convex run --component migrations lib:getStatus --watch",
    "postinstall": "./scripts/postinstall.sh",
    "patch:framework7": "./scripts/generate-framework7-popover-patch.sh",
    "preview": "npm run build && cross-env NODE_ENV=production vite preview",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.config.dev.ts",
    "test:e2e:prod": "playwright test --config=playwright.config.prod.ts",
    "test:e2e:all": "npm run test:e2e:dev && npm run test:e2e:prod",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:headed:slow": "HEADED=1 playwright test",
    "test:e2e:headed:slower": "HEADED=1 SLOWMO=2000 playwright test",
    "test:e2e:headed:slowest": "HEADED=1 SLOWMO=3000 playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:component": "playwright test -c playwright-ct.config.ts",
    "test:all": "npm run test:e2e && npm run test:component",
    "test:report": "playwright show-report",
    "test:install": "playwright install --with-deps",
    "lint": "npm run tsc",
    "tsc": "./node_modules/.bin/tsc --noEmit -p tsconfig.app.json"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 25 Chrome versions",
    "last 25 Firefox versions"
  ],
  "overrides": {
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.110",
    "@ai-sdk/vue": "^3.0.256",
    "@convex-dev/migrations": "^0.3.6",
    "@inlang/paraglide-js": "^2.22.0",
    "@types/sortablejs": "^1.15.9",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.3.0",
    "ai": "^6.0.256",
    "apexcharts": "^5.16.0",
    "baseline-browser-mapping": "^2.11.14",
    "bcryptjs": "^3.0.3",
    "caniuse-lite": "^1.0.30001809",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "convex-helpers": "^0.1.123",
    "convex-vue": "^0.1.5",
    "cyrillic-to-translit-js": "^3.2.1",
    "dayjs": "^1.11.22",
    "dom7": "^4.0.6",
    "dompurify": "^3.4.13",
    "es-toolkit": "^1.49.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framework7": "^9.1.2",
    "framework7-vue": "^9.1.2",
    "fuse.js": "^7.5.0",
    "glob": "^13.0.6",
    "jose": "^6.2.9",
    "jszip": "^3.10.1",
    "livekit-client": "^2.20.2",
    "localforage": "^1.10.0",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.12.1",
    "marked": "^18.0.9",
    "maska": "^3.2.0",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sharp": "^0.35.3",
    "skeleton-elements": "^4.0.1",
    "sortablejs": "^1.15.7",
    "svgo": "^4.0.2",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue": "^3.5.41",
    "vue-advanced-cropper": "^2.8.9",
    "vue3-apexcharts": "^1.11.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify/vue": "^5.0.1",
    "@playwright/experimental-ct-vue": "^1.61.1",
    "@playwright/test": "^1.61.1",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "autoprefixer": "^10.5.4",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "postcss": "^8.5.26",
    "postcss-preset-env": "^11.3.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "ts-morph": "^28.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-webfont-dl": "^3.12.0"
  }
}
